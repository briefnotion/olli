#pragma once

// Generated by GenerateVersionHeader.cmake, run on every build (not just on
// reconfigure) - see that script for why the git command lives there
// instead of directly in CMakeLists.txt's own configure step. Content-based
// (git describe --always --dirty), not time-based: two people building the
// exact same commit get the exact same string here, unlike a __DATE__/
// __TIME__ stamp, which differs by whoever/whenever compiled it even for
// byte-for-byte identical source.
#define OLLI_GIT_VERSION "@OLLI_GIT_VERSION@"
